<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vsi_black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="22dp"
            android:text="Backups"
            android:textColor="@color/vsi_text"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="2dp"
            android:text="Apps sichern und wiederherstellen"
            android:textColor="@color/vsi_text_secondary"
            android:textSize="15sp" />

        <androidx.cardview.widget.CardView
            android:id="@+id/card_search"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="@color/vsi_surface"
            app:cardCornerRadius="26dp"
            app:cardElevation="0dp"
            app:contentPadding="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/ib_backup_toolbar_action"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="11dp"
                    android:tint="@color/vsi_accent"
                    app:srcCompat="@drawable/ic_clear_selection" />

                <LinearLayout
                    android:id="@+id/container_backup_search_bar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="visible">

                    <EditText
                        android:id="@+id/et_search"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="@string/backup_search_hint"
                        android:inputType="text"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:singleLine="true"
                        android:textColor="@color/vsi_text"
                        android:textColorHint="@color/vsi_text_secondary"
                        android:textSize="15sp" />

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/ib_backup_search_more"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="11dp"
                        android:tint="@color/vsi_text_secondary"
                        app:srcCompat="@drawable/ic_more" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/container_backup_selection_bar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_backup_selection_status"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="start|center_vertical"
                        android:paddingStart="8dp"
                        android:textColor="@color/vsi_text"
                        android:textSize="15sp" />

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/ib_backup_select_all"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="11dp"
                        android:tint="@color/vsi_accent"
                        app:srcCompat="@drawable/ic_select_all" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_packages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="88dp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_backup_action"
        style="@style/VSIMaterialButton.ExtendedFab"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="14dp"
        android:text="@string/backup_filter"
        app:backgroundTint="@color/vsi_accent"
        app:cornerRadius="24dp"
        app:icon="@drawable/ic_filter"
        app:iconTint="#261832" />

    <FrameLayout
        android:id="@+id/overlay_backup_indexing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:clickable="true"
        android:focusable="true"
        android:translationZ="9998dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="28dp"
            android:background="@drawable/vsi_bg_card"
            android:orientation="vertical"
            android:padding="24dp">

            <ProgressBar
                android:id="@+id/progress_backup_indexing"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminateTint="@color/vsi_accent"
                android:progressTint="@color/vsi_accent" />

            <TextView
                android:id="@+id/tv_backup_indexing_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:text="@string/backup_indexing"
                android:textColor="@color/vsi_text" />
        </LinearLayout>
    </FrameLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container_backup_storage_setup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/vsi_black"
        android:clickable="true"
        android:focusable="true"
        android:translationZ="9999dp"
        android:visibility="gone" />
</FrameLayout>
