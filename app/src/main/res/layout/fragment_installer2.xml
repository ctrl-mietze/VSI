<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vsi_black"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="22dp"
    android:paddingEnd="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VSI"
                android:textColor="@color/vsi_text"
                android:textSize="38sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Virtual Source Installer · by Veyra"
                android:textColor="@color/vsi_text_secondary"
                android:textSize="16sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/ib_help"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/help"
            android:padding="12dp"
            android:tint="@color/vsi_text_secondary"
            app:srcCompat="@drawable/ic_help" />

        <ImageButton
            android:id="@+id/ib_toggle_theme"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/installer_select_theme"
            android:padding="12dp"
            android:tint="@color/vsi_accent"
            app:srcCompat="@drawable/ic_dark_theme" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="@color/vsi_hero"
        app:cardCornerRadius="30dp"
        app:cardElevation="0dp"
        app:contentPadding="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="6dp"
                    android:tint="@color/vsi_text"
                    app:srcCompat="@drawable/ic_install_full" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="App installieren"
                        android:textColor="@color/vsi_text"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="APK, APKS, APKM, XAPK oder ZIP auswählen"
                        android:textColor="#D6C5E8"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_install"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:text="@string/installer_install_apks"
                android:textAllCaps="false"
                android:textColor="#261832"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/vsi_accent"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_install_full"
                app:iconGravity="textStart"
                app:iconTint="#261832" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="10dp"
        android:letterSpacing="0.12"
        android:text="INSTALLATIONEN"
        android:textColor="@color/vsi_text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_installer_sessions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="20dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/container_installer_placeholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/vsi_bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="22dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="7dp"
                android:tint="@color/vsi_accent"
                app:srcCompat="@drawable/ic_history" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Noch keine Installation"
                    android:textColor="@color/vsi_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_installer_placeholder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/installer_placeholder_text"
                    android:textColor="@color/vsi_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
