    <string name="vsi_patcher_title">VSI Patcher</string>
    <string name="vsi_patcher_summary">Installer integration tiers: Patch Lite session-oriented है, Patch VSI profile 0 को बदलता है और Patcher Pro persistent systemless priv-app module बनाता है।</string>
