    <string name="vsi_patch_lite">Patch Lite</string>
    <string name="vsi_patch_lite_summary">KernelSU/Magisk service module बनाता है जो root उपलब्ध होने पर VSI routing सक्रिय करता है। System partition file नहीं बदली जाती।</string>
    <string name="vsi_patch_lite_remove">Patch Lite हटाएँ</string>
    <string name="vsi_patch_lite_remove_summary">Patch Lite module हटाएँ।</string>
